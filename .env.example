# LLM provider configuration
#
# Values live in the Vercel dashboard for production. For local runs, pass
# them inline (no dotenv loader): `LLM_API_KEY=... LLM_PROVIDER=... npm run server`.
# The local fallback simulator needs NO key at all.
#
# Provider selection precedence:
#   request body `provider`  >  LLM_PROVIDER env  >  legacy single-provider env
# The registry of valid names lives in api/lib/llm-providers.js. Adding a
# provider = add an entry there + set its key env var.

# --- Named-provider mode (recommended) ---
# LLM_PROVIDER=dashscope            # dashscope | deepseek | openai | claude
# LLM_PROVIDER_CHAIN=dashscope,claude,deepseek   # failover priority, tried left to right

# Per-provider model fallback lists (ordered, comma-separated; model IDs
# are per-endpoint namespaces — DashScope hosts glm/kimi/qwen under its
# own IDs). Registry defaults verified against the live /models APIs:
#   dashscope: qwen3-max -> glm-5 -> kimi-k3
#   deepseek:  deepseek-v4-flash -> deepseek-v4-pro (hybrid reasoning)
#   claude:    claude-sonnet-4-5 -> claude-opus-4-6
# DASHSCOPE_MODEL=qwen3-max,glm-5,kimi-k3
# DEEPSEEK_MODEL=deepseek-v4-flash,deepseek-v4-pro
# ANTHROPIC_MODEL_1=claude-opus-4-6   # + ANTHROPIC_MODEL_2 as next fallback
LLM_API_KEY=                        # legacy alias key, also read by dashscope
# DASHSCOPE_API_KEY=                # dashscope key (provider-native name)
# DEEPSEEK_API_KEY=                 # key for the deepseek entry
# OPENAI_API_KEY=                   # key for the openai entry
# ANTHROPIC_API_BASE=               # claude: relay or https://api.anthropic.com
# ANTHROPIC_API_KEY_1=              # claude key (ANTHROPIC_API_KEY_2 = spare)
# ANTHROPIC_MODEL_1=                # optional; defaults to claude-sonnet-4-5

# --- Legacy single-provider mode (used when no provider is named) ---
# LLM_API_BASE_URL=https://.../v1   # any OpenAI-compatible endpoint
# LLM_MODEL=qwen-max
# OPENAI_API_KEY= / LLM_API_TOKEN= / OPENAI_KEY=   # legacy key aliases

# --- Operational knobs (all optional) ---
# MENTOR_UPSTREAM_TIMEOUT_MS=25000  # per-mentor upstream budget
# MENTOR_HISTORY_MAX_ITEMS=36
# MENTOR_HISTORY_MAX_CHARS=6000
# MENTOR_TABLE_KV_LIMIT=30          # KV shed ceiling per 60s window
# MENTOR_BATCH_FANOUT=1             # one upstream call for the whole table
# LLM_DISABLED=1
# MENTOR_DEBUG_PROMPT_ENABLED=1  # prod default: /api/mentor-debug-prompt is 404 (prompt IP)
# LLM_TOKEN_HOURLY_BUDGET=1000000  # per-instance rolling-hour upstream token ceiling (call budget: LLM_HOURLY_BUDGET)                    # emergency cost kill switch
